# Runtime mode: use production only with unique secrets and TLS at the edge.
UTTG_ENVIRONMENT=development

# API listener port inside the application container.
UTTG_API_PORT=8000

# Structured application log level.
UTTG_LOG_LEVEL=info

# PostgreSQL password used by the local Docker Compose database.
UTTG_POSTGRES_PASSWORD=replace-with-a-strong-database-password

# PostgreSQL / TimescaleDB async connection URL.
UTTG_DATABASE_URL=postgresql+asyncpg://uttg:replace-with-a-strong-database-password@db:5432/uttg

# Maximum persistent PostgreSQL connections per API process.
UTTG_DATABASE_POOL_SIZE=10

# Maximum temporary PostgreSQL connections above the base pool per API process.
UTTG_DATABASE_MAX_OVERFLOW=5

# Maximum seconds to wait for a PostgreSQL pool connection.
UTTG_DATABASE_POOL_TIMEOUT_SECONDS=2

# PostgreSQL statement timeout in milliseconds.
UTTG_DATABASE_STATEMENT_TIMEOUT_MS=3000

# Valkey connection URL used for cache, locks, idempotency, and rate limits.
UTTG_VALKEY_URL=valkey://valkey:6379/0

# Maximum Valkey memory for the local Docker Compose deployment.
UTTG_VALKEY_MAXMEMORY=1gb

# NATS JetStream connection URL.
UTTG_NATS_URL=nats://nats:4222

# IP-fingerprint HMAC secret for privacy-preserving public rate limits.
UTTG_IP_FINGERPRINT_SECRET=replace-with-a-different-32-character-or-longer-secret

# Webhook encryption secret; generate independently and preserve it across deployments.
UTTG_WEBHOOK_ENCRYPTION_KEY=replace-with-another-unique-32-character-secret

# Comma-separated reverse-proxy addresses trusted to supply X-Forwarded-For.
UTTG_TRUSTED_PROXIES=reverse-proxy

# Comma-separated browser origins allowed by CORS; wildcard is forbidden in production.
UTTG_CORS_ORIGINS=https://uttg.example.com

# API worker count used by Docker Compose.
UTTG_API_WORKERS=2

# Maximum accepted HTTP request body size in bytes.
UTTG_REQUEST_BODY_MAX_BYTES=1048576

# Maximum concurrent webhook HTTP deliveries per worker.
UTTG_WEBHOOK_DELIVERY_CONCURRENCY=32

# Maximum webhook messages fetched in one JetStream batch.
UTTG_WEBHOOK_BATCH_SIZE=32

# Maximum webhook delivery attempts before dead-lettering.
UTTG_WEBHOOK_MAX_ATTEMPTS=5

# Maximum active webhook registrations owned by one IP fingerprint.
UTTG_WEBHOOK_MAX_PER_IP=5

# Outbound webhook timeout in seconds.
UTTG_WEBHOOK_TIMEOUT_SECONDS=10

# Maximum serialized webhook payload size in bytes.
UTTG_WEBHOOK_MAX_BODY_BYTES=262144

# Maximum in-memory request analytics backlog per API process.
UTTG_ANALYTICS_QUEUE_SIZE=20000

# Request analytics rows written per PostgreSQL batch.
UTTG_ANALYTICS_BATCH_SIZE=500

# Maximum seconds between request analytics flushes.
UTTG_ANALYTICS_FLUSH_SECONDS=0.5

# OpenTelemetry collector endpoint; leave empty when tracing is disabled.
UTTG_OTEL_EXPORTER_OTLP_ENDPOINT=

# NASA Open APIs: obtain a key at https://api.nasa.gov/
UTTG_NASA_API_KEY=

# Space-Track account identity: register at https://www.space-track.org/auth/createAccount
UTTG_SPACE_TRACK_IDENTITY=

# Space-Track account password: register at https://www.space-track.org/auth/createAccount
UTTG_SPACE_TRACK_PASSWORD=

# The Space Devs API access: see https://thespacedevs.com/llapi
UTTG_THE_SPACE_DEVS_API_KEY=

# CelesTrak public GP feed: documentation at https://celestrak.org/NORAD/documentation/gp-data-formats.php
UTTG_ENABLE_CELESTRAK=true

# NOAA SWPC public JSON feeds: documentation at https://www.swpc.noaa.gov/products-and-data
UTTG_ENABLE_NOAA_SWPC=true

# JPL Horizons API: documentation at https://ssd-api.jpl.nasa.gov/doc/horizons.html
UTTG_ENABLE_JPL=true

# ESA integration remains disabled until an exact official product API is selected.
UTTG_ENABLE_ESA=false

# The Space Devs public Launch Library API: documentation at https://thespacedevs.com/llapi
UTTG_ENABLE_SPACE_DEVS_PUBLIC_API=true

# Grafana administrator password for the optional observability profile.
UTTG_GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
