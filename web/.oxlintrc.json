{
  "plugins": [
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "_destructor"
        ]
      }
    ]
  }
}
