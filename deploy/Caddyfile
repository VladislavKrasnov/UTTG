{
	servers {
		protocols h1 h2 h3
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}
}

(api_upstream) {
	reverse_proxy {
		dynamic a {
			name tasks.api
			port 8000
			refresh 5s
		}
		lb_policy least_conn
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri /v1/ready
		health_interval 5s
		health_timeout 2s
		transport http {
			dial_timeout 2s
			response_header_timeout 15s
		}
	}
}

(same_origin_api) {
	@api path /v1/*
	@internal path /v1/admin* /metrics
	respond @internal 404
	handle @api {
		import api_upstream
	}
}

(static_site) {
	root * /srv/{args[0]}
	encode zstd gzip
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
	try_files {path} {path}/ /index.html
	file_server
}

uttg.oxis.cc {
	import hardening
	encode zstd gzip
	@internal path /metrics /v1/admin*
	respond @internal 404
	import api_upstream
}

demo.uttg.oxis.cc {
	import hardening
	import same_origin_api
	handle {
		import static_site demo
	}
}

presentation.uttg.oxis.cc {
	import hardening
	import same_origin_api
	handle {
		import static_site presentation
	}
}

hub.uttg.oxis.cc {
	import hardening
	import same_origin_api
	handle {
		import static_site hub
	}
}

